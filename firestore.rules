rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Neurons collection
    match /neurons/{neuronId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    // Synapses collection
    match /synapses/{synapseId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    // Spikes collection
    match /spikes/{spikeId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if false; // Only functions can update
      allow delete: if false; // Spikes are immutable
    }
  }
}
