rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile photos
    match /users/{userId}/profile/{fileName} {
      // Anyone can read profile photos
      allow read: if true;

      // Only the user can upload/update their own profile photo
      allow write: if isOwner(userId) &&
        request.resource.size < 5 * 1024 * 1024 && // Max 5MB
        request.resource.contentType.matches('image/.*');

      // Only the user can delete their own profile photo
      allow delete: if isOwner(userId);
    }

    // Post attachments (if needed in future)
    match /posts/{postId}/{fileName} {
      // Anyone can read post attachments
      allow read: if true;

      // Only authenticated users can upload (post author validation done in Firestore)
      allow write: if isAuthenticated() &&
        request.resource.size < 10 * 1024 * 1024 && // Max 10MB
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('application/pdf'));

      allow delete: if isAuthenticated();
    }
  }
}
